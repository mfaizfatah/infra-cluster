# ============================================================
# Superuser PostgreSQL
# ============================================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=ganti_dengan_password_kuat
POSTGRES_DB=postgres

# ============================================================
# App 1 - ganti sesuai nama aplikasi
# ============================================================
APP1_DB=app1-db
APP1_USER=app1-user
APP1_PASSWORD=ganti_dengan_password_kuat

# ============================================================
# VPS Spec - pilih salah satu sesuai RAM VPS
# ============================================================
# 1GB RAM → ./configs/postgresql-1gb.conf
# 2GB RAM → ./configs/postgresql-2gb.conf
# 4GB RAM → ./configs/postgresql-4gb.conf
POSTGRES_CONF=./configs/postgresql-1gb.conf

# ============================================================
# Memory limits Docker container - sesuaikan dengan VPS
# ============================================================
# 1GB VPS → LIMIT=512m  / RESERVATION=256m
# 2GB VPS → LIMIT=1.2G  / RESERVATION=512M
# 4GB VPS → LIMIT=2.5G  / RESERVATION=1G
POSTGRES_MEMORY_LIMIT=512m
POSTGRES_MEMORY_RESERVATION=256m
