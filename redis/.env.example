# ============================================================
# Redis password (requirepass)
# ============================================================
REDIS_PASSWORD=ganti_dengan_password_kuat

# ============================================================
# Redis internal memory limit (maxmemory) — data/queue budget
# ============================================================
# Kebijakan eviction selalu "noeviction" (hardcoded di docker-compose.yml,
# BUKAN dari env var) — queue tidak boleh silently drop job saat
# memory penuh. Lihat tj-api/docs/adr/ADR-009-redis-email-queue-and-cache.md.
REDIS_MAXMEMORY=128mb

# ============================================================
# Docker container resource limits
# ============================================================
# Sengaja di atas REDIS_MAXMEMORY untuk kasih headroom proses Redis sendiri
# (koneksi client, buffer AOF rewrite yang bisa numpuk ~2x saat BGREWRITEAOF).
# Default di bawah dihitung untuk VPS 3.8GB RAM / 2 CPU core (cek `free -h`
# dan `nproc` di server produksi kalau VPS-nya beda — postgres di VM yang
# sama sudah pakai limit 2.5G/2GB reservation, jadi Redis sengaja dikasih
# jatah kecil, bukan proporsional 1:1 ke total RAM).
REDIS_MEMORY_LIMIT=256m
REDIS_MEMORY_RESERVATION=128m
REDIS_CPU_LIMIT=0.5
REDIS_CPU_RESERVATION=0.1
